# Copy this file to .env and fill in real values.
# .env is gitignored and should never be committed.

# Supabase project URL — found in Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key — found in Settings → API
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase service role key — found in Settings → API
# Never use the VITE_ prefix for this key — it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Feature flags ──────────────────────────────────────────────────────────────
# The funding-request system (student_athletes, funding_requests tables,
# Dashboard/NewRequest/Profile pages) is kept in the codebase but intentionally
# dormant — this flag is unused right now, not wired to any route. It exists
# as a marker that the feature was deliberately turned off, not deleted.
VITE_ENABLE_BUDGETING=false

